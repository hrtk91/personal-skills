{
  "name": "personal-skills",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "skillsctl": "./tools/dist/skills-ctl.mjs",
    "skills-ctl": "./tools/dist/skills-ctl.mjs"
  },
  "files": [
    "skills",
    "rules",
    "hooks",
    "tools/dist",
    "package.json"
  ],
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@clack/prompts": "1.7.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  },
  "scripts": {
    "build:cli": "esbuild tools/skills-ctl.ts --bundle --packages=external --platform=node --format=esm --target=node24 --outfile=tools/dist/skills-ctl.mjs",
    "skillsctl": "node tools/skills-ctl.ts",
    "skills-ctl": "npm run skillsctl --",
    "test:skills-ctl": "node --test tools/skills-ctl.test.ts tools/skills-ctl/*.test.ts hooks/single-review-decision/*.test.mjs"
  }
}
