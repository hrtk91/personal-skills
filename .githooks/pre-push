#!/usr/bin/env bash
set -u

root=$(git rev-parse --show-toplevel) || exit 1
checker="$root/tools/pre-push-check/check.sh"
failed=0

while read -r local_ref local_sha remote_ref remote_sha; do
  [[ -n ${local_ref:-} ]] || continue
  # Deleting a remote branch does not introduce commits.
  [[ $local_sha =~ ^0+$ ]] && continue

  if [[ $remote_sha =~ ^0+$ ]]; then
    if ! git -C "$root" rev-parse --verify origin/main^{commit} >/dev/null 2>&1; then
      echo "pre-push: cannot check new branch; origin/main is unavailable" >&2
      failed=1
      continue
    fi
    range="origin/main..$local_sha"
  else
    range="$remote_sha..$local_sha"
  fi

  echo "pre-push: checking $local_ref ($range)" >&2
  if ! "$checker" "$range"; then
    failed=1
  fi
done

exit "$failed"
