# プロジェクト側で埋め、承認後に読み込む。空の必須項目があると handoff.sh は起動しない。
REPO=
HERDR_WORKSPACE_ID=
LIMITS_SUPERVISOR_NAME=
HANDOFF_FILE=handoff/supervisor-codex.md
LIMITS_SUPERVISOR_MODEL=gpt-6.1-sol
LIMITS_SUPERVISOR_EFFORT=max
LIMITS_SUPERVISOR_TIER=priority
LIMITS_SUPERVISOR_SANDBOX=danger-full-access
LIMITS_SUPERVISOR_APPROVAL=never
# 記録の場所が標準と違う場合だけ、LIMITS_CODEX_SESSIONS を指定する。
