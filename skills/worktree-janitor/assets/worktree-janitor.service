[Service]
Type=oneshot
ExecStart=/usr/bin/python3 %h/.codex/skills/worktree-janitor/scripts/worktree_janitor.py --config %h/.config/worktree-janitor/config.json --state %h/.local/state/worktree-janitor/state.json --execute
