{
  "name": "task-dashboard",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "react-router dev --host 0.0.0.0",
    "start": "PORT=8790 HOST=0.0.0.0 react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc --noEmit",
    "build": "react-router typegen && react-router build",
    "test": "node --experimental-strip-types --no-warnings --test app/**/*.test.ts"
  },
  "dependencies": {
    "@react-router/node": "^8.4.0",
    "@react-router/serve": "^8.4.0",
    "isbot": "^5.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@react-router/dev": "^8.4.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
