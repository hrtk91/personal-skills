[Unit]
Description=Task dashboard (React Router)
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/repos/personal-skills/tools/task-ledger/web
Environment=HOST=0.0.0.0
Environment=PORT=8790
Environment=TASK_LEDGER_DB=%h/.local/share/task-ledger/ledger.sqlite
ExecStart=/usr/bin/env npm run start
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
